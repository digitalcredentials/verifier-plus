# Where shared credentials are kept: memory, mongodb or dynamodb (required).
# See settings.contract.json for every setting.
CREDENTIAL_STORE=mongodb

# MongoDB connection info: DB_URI, or (as in 2.x, for MongoDB Atlas) DB_HOST
# with DB_USER and DB_PASS. Not both.
DB_URI=mongodb://127.0.0.1:27017
#DB_USER=
#DB_PASS=
#DB_HOST=your-cluster.mongodb.net
DB_NAME=verifier-plus-DEV
DB_COLLECTION=credentials

# General deploy info (used in the provided docker-compose.example.production.yml)
URL=verifierplus.org
HTTPSPORT=443
HTTPPORT=80

# Requesting credentials from the Learner Credential Wallet: on or off (required)
EXCHANGES=on
# Where wallets reach the exchange (optional; defaults to the address the
# browser used to reach the page)
#EXCHANGE_SERVER_URL=https://verifierplus.org
